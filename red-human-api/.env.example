# ============================================================
# Red Human AI — API · Variables de entorno
# Copia este archivo a `.env` y llena las claves que tengas.
# La API funciona SIN claves (modo demo con respuestas simuladas);
# cada clave que agregues activa esa capacidad real.
# ============================================================

# --- Base de datos ---
# Dev: SQLite (por defecto, no requiere nada)
# Prod (VPS): postgresql+psycopg://usuario:password@localhost:5432/redhuman
DATABASE_URL=sqlite:///./redhuman.db

# Zona horaria de la organización (la base guarda UTC; todo se muestra/captura en esta zona).
# Debe coincidir con NEXT_PUBLIC_ZONA_HORARIA del frontend.
ZONA_HORARIA=America/Mexico_City

# --- API #1 · OpenAI (el cerebro) ---
# Se usa para: extractor de CV, generador de vacantes, agente de prefiltro,
# validación de documentos del expediente.
# Obtener en: https://platform.openai.com  →  API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- API #2 · Anam (avatar de video para entrevistas) ---
# Se usa para: entrevista en video con avatar neutral (módulo 3.10).
# Anam pone cara/voz/oído; el cerebro es NUESTRO modelo de OpenAI.
# Sin clave, la entrevista funciona en modo texto con el mismo agente IA.
# Obtener en: https://lab.anam.ai/register  →  crea tu cuenta gratis (30 min/mes)
#   →  API Keys (copia la clave)  →  en "Avatars" elige un avatar del catálogo
#   y copia su ID (usa avatares neutrales del catálogo, no clones de personas).
# ANAM_LLM_ID: registra tu endpoint de OpenAI una vez con
#   POST https://api.anam.ai/v1/llms  {displayName, urls:[{url:"https://api.openai.com/v1/chat/completions"}],
#   llmFormat:"openai", modelName:$OPENAI_MODEL, secret:$OPENAI_API_KEY}
#   y pega aquí el id que regresa. Si rotas la clave de OpenAI, actualiza la registración.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ANAM_LLM_ID=

# URL pública del frontend (se usa para armar las ligas de entrevista)
APP_URL=http://localhost:3000

# --- API #3 · WhatsApp ---
# WHATSAPP_PROVIDER: "meta" | "waha" | "evolution" | vacío = modo demo (guarda sin enviar)
#
# Opción A (recomendada): Meta WhatsApp Cloud API — número oficial verificado.
#   developers.facebook.com → crea una app tipo "Negocio" → agrega WhatsApp.
#   META_PHONE_NUMBER_ID / META_WABA_ID: panel de WhatsApp → Configuración de la API.
#   META_WHATSAPP_TOKEN: genera un System User en Business Manager con permisos
#     whatsapp_business_messaging + whatsapp_business_management y token SIN caducidad
#     (el token de prueba de 24 h sirve solo para probar).
#   META_VERIFY_TOKEN: cadena que tú inventas; la capturas igual en el panel al
#     dar de alta el webhook https://api.tudominio.mx/webhooks/whatsapp
#   META_APP_SECRET: app → Configuración → Básica. Valida la firma de cada webhook.
#   META_PLANTILLA_AVISO: nombre de una plantilla aprobada. Se usa cuando el
#     candidato lleva más de 24 h sin escribir (Meta rechaza el texto libre, error 131047).
WHATSAPP_PROVIDER=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WHATSAPP_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v21.0
META_PLANTILLA_AVISO=
META_PLANTILLA_IDIOMA=es_MX

# Opción B: gateway propio en tu VPS (sin costo por mensaje de Meta)
#   WAHA      → https://waha.devlike.pro  (docker: devlikeapro/waha)
#   Evolution → https://github.com/EvolutionAPI/evolution-api
WAHA_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=redhuman

# --- CORS (frontend) ---
CORS_ORIGINS=http://localhost:3000

# --- Añadido en red-human-v2.0 ---
ANAM_MAX_SESION_SEG=900
ADMIN_EMAIL=admin@redhuman.mx
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=
WHATSAPP_PUBLIC_NUMBER=

# --- Correo transaccional (Resend) — Fase D / 7A ---
# Sin RESEND_API_KEY el correo NO sale (queda "no enviado" en el historial de notificaciones).
# El remitente de sandbox (onboarding@resend.dev) SOLO entrega al correo dueño de la cuenta Resend:
# para candidatos/entrevistadores reales verifica un dominio propio en Resend y ponlo en RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=Red Human AI <notificaciones@tudominio.mx>

# --- Microsoft Teams / Microsoft 365 (Fase 7B) — nombres EXACTOS ---
# App Registration en Azure (permisos DELEGADOS: Calendars.ReadWrite, User.Read, offline_access).
# Redirect URI a registrar en Azure: https://<api>/integraciones/teams/callback (la muestra
# Configuración → Integraciones). Vacías = la videollamada pide la liga a mano, como siempre.
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=
TEAMS_CLIENT_SECRET=
# Opcional: fija la Redirect URI si la API corre detrás de un proxy que no manda el host público.
TEAMS_REDIRECT_URI=

# --- Dropbox Sign: firma electrónica incrustada (2026-09-29) ---
# API app con el dominio de la app registrado y white labeling configurado en Dropbox Sign.
# Callback de la API app: https://<api>/api/webhooks/dropbox   · Vacías = firma no disponible (PDF + carga manual).
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_TEST_MODE=false

# --- Psicométricas.mx (2026-09-29) --- https://psicometricas.mx/api
# Su API pide Token + Password. Si no hay PSICOMETRICAS_PASSWORD se usa PSICOMETRICAS_USUARIO como Password.
# Webhook («Registros de API»): https://<api>/api/webhooks/psicometricas?secreto=<PSICOMETRICAS_WEBHOOK_SECRET>
PSICOMETRICAS_TOKEN=
PSICOMETRICAS_PASSWORD=
PSICOMETRICAS_USUARIO=
PSICOMETRICAS_WEBHOOK_SECRET=
# Opcional: liga de acceso del candidato con {clave} (su API no la regresa; Psicométricas la manda por correo)
PSICOMETRICAS_URL_CANDIDATO=

